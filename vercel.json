{
    "version": 2,
    "builds": [
        {
            "src": "package.json",
            "use": "@vercel/next"
        }
    ],
    "env": {
        "MONGODB_URI": "@mongodb-uri",
        "MONGODB_DB": "@mongodb-db"
    },
    "functions": {
        "src/app/api/**/*.ts": {
            "maxDuration": 30
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        }
    ],
    "regions": ["iad1"],
    "framework": "nextjs"
}
