# 🔧 Variáveis de Ambiente - Math Learn

# =============================================================================
# BANCO DE DADOS (OBRIGATÓRIO)
# =============================================================================

# MongoDB Atlas (Produção/Recomendado)
MONGODB_URI=mongodb+srv://admin:SUA_SENHA@math-learn-cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority

# MongoDB Local (Desenvolvimento)
# MONGODB_URI=mongodb://localhost:27017

# Nome do banco de dados
MONGODB_DB=math-learn

# =============================================================================
# CONFIGURAÇÕES OPCIONAIS
# =============================================================================

# Ambiente (development, production, test)
NODE_ENV=development

# URL base da aplicação (para SEO/metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# INSTRUÇÕES DE CONFIGURAÇÃO
# =============================================================================

# 1. PARA DESENVOLVIMENTO LOCAL:
#    - Copie este arquivo para .env.local
#    - Configure MONGODB_URI para Atlas ou local
#    - Execute: npm run dev

# 2. PARA PRODUÇÃO (VERCEL):
#    - Vá em: Project Settings → Environment Variables
#    - Adicione MONGODB_URI e MONGODB_DB
#    - Deploy automático após push

# 3. PARA DOCKER:
#    - Use docker-compose.yml (MongoDB incluído)
#    - Execute: npm run docker:dev

# =============================================================================
# LINKS ÚTEIS
# =============================================================================

# MongoDB Atlas: https://atlas.mongodb.com
# Vercel Dashboard: https://vercel.com/dashboard
# Documentação: /docs/deployment/MONGODB_ATLAS_SETUP.md
