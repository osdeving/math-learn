# Environment variables para Docker
# Copie este arquivo para .env.local para desenvolvimento local

# MongoDB
MONGODB_URI=mongodb://admin:password123@mongodb:27017/mathlearn?authSource=admin

# Next.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-change-in-production

# Node Environment
NODE_ENV=production

# Application Settings
APP_NAME=Math Learn Platform
APP_VERSION=1.0.0

# Database Settings
DB_NAME=mathlearn
DB_USER=mathlearn_user
DB_PASSWORD=mathlearn_password
